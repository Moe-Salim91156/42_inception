# ⚠️  CRITICAL: Change 'yourlogin' to your actual 42 login
# ⚠️  This file must be added to .gitignore — never commit it!

DOMAIN_NAME=msalim.42.fr

# MySQL / MariaDB settings
# ⚠️  Passwords are NOT stored here — they come from Docker secrets
#     Only non-sensitive config goes in .env
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser

# WordPress settings
# ⚠️  Admin username CANNOT contain: admin, Admin, administrator, Administrator
#     Examples of FORBIDDEN names: admin, admin-42, myadmin, administrator
#     Examples of ALLOWED names: master, webmaster, superuser, wpmaster
WP_ADMIN_USER=master
WP_ADMIN_EMAIL=master@msalim.42.fr

# Second (non-admin) WordPress user
WP_USER=normaluser
WP_USER_EMAIL=user@msalim.42.fr
WP_USER_PASS=UserPass123!
